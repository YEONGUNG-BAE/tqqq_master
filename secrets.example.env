# Copy to secrets.env on YOUR Mac and chmod 600. Do not upload actual keys.
MERITZ_CLIENT_ID=
MERITZ_CLIENT_SECRET=
# Optional 12-digit uppercase MAC, with no colons. Otherwise uuid.getnode().
# MERITZ_MAC_ADDRESS=
# Optional failure email to your own address, configured and tested locally.
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=465
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_FROM=
# ALERT_TO=
# Optional Telegram result notifications (bot token from @BotFather, your chat id).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Optional external monitor (runs on ANOTHER host; see README). Shared HMAC secret.
# MONITOR_URL=
# MONITOR_SECRET=
